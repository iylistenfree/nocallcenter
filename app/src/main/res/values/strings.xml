    <!-- Onboarding / Welcome -->
    <string name="onboarding_welcome_title">Welcome to NoCallCenter</string>
    <string name="onboarding_welcome_subtitle">Your privacy-first defense against telemarketing</string>
    <string name="onboarding_how_it_works_title">How It Works</string>
    <string name="onboarding_step1_title">1. Instant Call Screening</string>
    <string name="onboarding_step1_desc">Incoming calls from numbers not in your contacts are automatically declined without ringing.</string>
    <string name="onboarding_step2_title">2. Smart Auto-SMS &amp; WhatsApp</string>
    <string name="onboarding_step2_desc">The app sends an automatic SMS citing the Do Not Call Registry and invites legitimate callers (couriers, doctors) to write on WhatsApp.</string>
    <string name="onboarding_step3_title">3. SMS Credit Protection</string>
    <string name="onboarding_step3_desc">Built-in monthly budget limiter and 48-hour anti-flood protection so you never waste your SMS plan.</string>
    
    <string name="onboarding_perm_guide_title">Android 14/15 Permission Setup</string>
    <string name="onboarding_perm_guide_desc">Google blocks SMS permissions for sideloaded apps. To make the 3-dots option appear, follow this exact sequence:</string>
    <string name="onboarding_perm_step1">1. Tap \"Open App Info Settings\" below, go to \"Permissions\", tap \"SMS\", tap \"Allow\" (even if greyed out and unselectable) and tap \"OK\" on the restricted popup.</string>
    <string name="onboarding_perm_step2">2. Go back to App Info: tap the 3 dots in the top-right corner (⋮) (it will now appear!).</string>
    <string name="onboarding_perm_step3">3. Tap \"Allow restricted settings\" and confirm with fingerprint or PIN.</string>
    <string name="onboarding_perm_step4">4. Re-enter Permissions > SMS and select \"Allow\".</string>
    <string name="btn_open_app_settings">Open App Info Settings</string>
    <string name="btn_get_started">Get Started</string>

